@model JsonElement[]

@{
    ViewData["Title"] = "Events";

    string Read(JsonElement e, string key) =>
        e.ValueKind == JsonValueKind.Object &&
        e.TryGetProperty(key, out var v)
            ? v.ToString()
            : "";
}

<!-- PAGE HEADER -->

<section class="events-banner">
    <div class="container py-5">

        <span class="eyebrow">FIND YOUR NEXT CHALLENGE</span>

        <h1 class="display-5 fw-bold mt-3">
            Race events<span class="text-primary">.</span>
        </h1>

        <p class="events-subtitle mb-0">
            Discover upcoming races, challenge yourself
            and find your next finish line.
        </p>

        <div class="events-header-line mt-4"></div>

    </div>
</section>

<!-- EVENTS LIST -->

<div class="container py-5">

    @if (Model.Length == 0)
    {
        <div class="empty-state">

            <div class="empty-icon">
                <span>🏁</span>
            </div>

            <h2 class="h4 fw-bold mt-3">
                No events available
            </h2>

            <p class="text-secondary">
                There are no events to display, or the
                API is currently unavailable.
            </p>

            <a class="btn btn-raceday mt-3"
               asp-controller="Home"
               asp-action="Index">
                Back home →
            </a>

        </div>
    }
    else
    {
        <div class="events-section-heading mb-4">

            <div>
                <span class="eyebrow">EXPLORE</span>
                <h2 class="h3 fw-bold mt-2">
                    Available races
                </h2>
            </div>

            <span class="events-count">
                @Model.Length events
            </span>

        </div>

        <div class="row g-4">

            @foreach (var e in Model)
            {
                var id = Read(e, "eventID");
                var name = Read(e, "eventName");
                var date = Read(e, "eventDate");
                var place = Read(e, "location");
                var status = Read(e, "status");
                var fee = Read(e, "entryFee");

                <div class="col-md-6 col-lg-4">

                    <article class="event-card h-100">

                        <!-- CARD HEADER -->

                        <div class="event-card-top">

                            <div class="d-flex justify-content-between align-items-center gap-2">

                                <span class="event-chip">
                                    RACE EVENT
                                </span>

                                <span class="status-pill">
                                    @(string.IsNullOrWhiteSpace(status)
                                                                ? "Open"
                                                                : status)
                                                                     </span>

                            </div>

                            <div class="event-number">
                                #@id
                            </div>

                            <div class="event-decoration"></div>

                        </div>

                        <!-- CARD BODY -->

                        <div class="event-card-body p-4">

                            <h2 class="h5 fw-bold event-title">
                                @name
                            </h2>

                            <div class="event-location mt-3">
                                <span class="location-icon">⌖</span>
                                <span>
                                    @(string.IsNullOrWhiteSpace(place)
                                                                ? "Location not provided"
                                                                : place)
                                                                    </span>
                                                                </div>

                            <hr class="event-divider" />

                            <div class="event-meta">

                                <div>
                                    <span class="meta-label">
                                        EVENT DATE
                                    </span>

                                    <strong>
                                        @date
                                    </strong>
                                </div>

                                <div class="text-end">
                                    <span class="meta-label">
                                        ENTRY FEE
                                    </span>

                                    <strong class="event-price">
                                        @(string.IsNullOrWhiteSpace(fee)
                                                                        ? "Fee TBC"
                                                                        : fee)
                            </strong>
                        </div>

                            </div>

                            <a class="btn btn-raceday w-100 mt-4"
                               asp-action="Details"
                               asp-route-id="@id">

                                View event details

                                <span class="ms-2">→</span>

                            </a>

                        </div>

                    </article>

                </div>
                }

        </div>
    }

</div>
