
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Main RaceDay stylesheet -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body class="raceday-body">

    @{
        var userName = Context.Session.GetString("UserName");
        var userRole = Context.Session.GetString("UserRole");

        var isLoggedIn = !string.IsNullOrWhiteSpace(userName);
        var isOrganiser = userRole == "Organiser";
        var isParticipant = userRole == "Participant";

        var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

        var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();

        var isHome = currentController == "Home";
        var isEvents = currentController == "Events";
    }

    <!-- =========================
         TOP NAVIGATION
    ========================= -->

    <header class="raceday-header">

        <nav class="navbar navbar-expand-lg raced-navbar">

            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand raced-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-mark">R</span>

                    <span>Race<span class="brand-highlight">Day</span></span>
                </a>

                <!-- Mobile navigation button -->
                <button class="navbar-toggler raced-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNav"
                        aria-controls="mainNav"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Navigation content -->
                <div class="collapse navbar-collapse" id="mainNav">

                    <!-- Main links -->
                    <ul class="navbar-nav mx-auto raced-nav-links">

                        <li class="nav-item">
                            <a class="nav-link @(isHome ? "active" : "")"
                               asp-controller="Home"
                               asp-action="Index">

                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(isEvents ? "active" : "")"
                               asp-controller="Events"
                               asp-action="Index">

                                Explore events
                            </a>
                        </li>

                        @if (isLoggedIn && isOrganiser)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isHome ? "active" : "")"
                                   asp-controller="Home"
                                   asp-action="Index">

                                    Organiser dashboard
                                </a>
                            </li>
                        }

                        @if (isLoggedIn && isParticipant)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isHome ? "active" : "")"
                                   asp-controller="Home"
                                   asp-action="Index">

                                    My RaceDay
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- Account section -->
                    <div class="raced-account">

                        @if (isLoggedIn)
                        {
                            <div class="raced-user-info">

                                <div class="raced-user-avatar">
                                    @userName?.Substring(0, 1).ToUpper()
                                </div>

                                <div class="raced-user-details">

                                    <span class="raced-user-name">
                                        @userName
                                    </span>

                                    <span class="raced-user-role">
                                        @userRole
                                    </span>

                                </div>

                            </div>

                            <form asp-controller="Auth"
                                  asp-action="Logout"
                                  method="post"
                                  class="raced-logout-form">

                                <button type="submit"
                                        class="btn raced-btn-outline">

                                    Sign out

                                </button>

                            </form>
                        }
                        else
                        {
                            <a class="btn raced-btn-outline"
                               asp-controller="Auth"
                               asp-action="Login">

                                Sign in
                            </a>

                            <a class="btn raced-btn-primary"
                               asp-controller="Auth"
                               asp-action="Register">

                                Join RaceDay
                            </a>
                        }

                    </div>

                </div>

            </div>

        </nav>

    </header>


    <!-- =========================
         MAIN CONTENT
    ========================= -->

    <main role="main" class="raced-main">

        <!-- Notifications -->
        <div class="container raced-notifications">

            @if (TempData["Success"] is string success)
            {
                <div class="alert raced-alert raced-alert-success"
                     role="status">

                    <span>@success</span>

                </div>
            }

            @if (TempData["Error"] is string error)
            {
                <div class="alert raced-alert raced-alert-error"
                     role="alert">

                    <span>@error</span>

                </div>
            }

        </div>

        <!-- Individual page content -->
        @RenderBody()

    </main>


    <!-- =========================
         FOOTER
    ========================= -->

    <footer class="raced-footer">

        <div class="container">

            <div class="raced-footer-content">

                <div class="raced-footer-brand">

                    <span class="brand-mark">R</span>

                    <span>
                        Race<span class="brand-highlight">Day</span>
                    </span>

                </div>

                <p>
                    Find your pace. Make it RaceDay.
                </p>

                <span class="raced-copyright">
                    © @DateTime.Now.Year RaceDay. All rights reserved.
                </span>

            </div>

        </div>

    </footer>


    <!-- JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
